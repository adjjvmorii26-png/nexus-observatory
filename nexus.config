{
  "version": "9.0.0-nexus",
  "lineage_count": 28,
  "interop": {
    "metric_keys": ["strength", "entropy", "coherence", "consensus"],
    "event_bus": "resonance_bus",
    "threshold": { "stabilize": 0.62, "collapse": 0.28, "overload": 0.85 }
  },
  "bridge": { "max_concurrent": 5, "cycle_ticks": 2, "exec_subset": 8 },
  "watch": { "interval_ms": 10000, "max_cycles": 5 },
  "journal": { "enabled": true, "max_entries": 100 }
}
